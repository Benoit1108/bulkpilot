# Copy to .env (git-ignored) to override docker compose defaults. No secret belongs here.
# Development works with no .env at all.

# Commercial name is a working title, only used for display (see docs/adr/0011).
APP_DISPLAY_NAME=BulkPilot

# Host ports published by the dev stack
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
POSTGRES_PORT=5432
MAILPIT_PORT=8025

# Local database credentials (development only)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Set to "debug" to enable Xdebug step debugging
XDEBUG_MODE=off

# Production only — provided by the server / secrets manager, never committed
# (the container refuses to start without the required ones, see docs/DEPLOYMENT.md):
# APP_SECRET=
# APP_ENCRYPTION_KEY=            # head -c 32 /dev/urandom | base64
# SERVER_NAME=
# DEFAULT_URI=https://app.example
# MAILER_DSN=
# MAILER_FROM=
# POSTGRES_PASSWORD=
# REGISTRATION_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
