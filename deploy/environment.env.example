# Settings and secrets of ONE environment of the server (docs/DEPLOYMENT.md, §3).
# bootstrap.sh copies this file twice, to /opt/bulkpilot/env/production.env and staging.env (mode 600,
# owned by deploy): fill each in on the server (`sudo -u deploy nano /opt/bulkpilot/env/production.env`),
# never in Git. Where staging differs, its value is given in a comment « staging : … ».
# Generate the secrets with:  openssl rand -hex 32   (APP_SECRET, POSTGRES_PASSWORD)
#                             openssl rand -base64 32 (APP_ENCRYPTION_KEY, BACKUP_PASSPHRASE)
# Values left empty on purpose may stay empty (Google, Sentry, heartbeats). Every other line must be
# filled: `grep -nE '^[A-Z_]+=$' /opt/bulkpilot/env/*.env` lists the ones that are not.

# —— Address ———————————————————————————————————————————————————————————————————————————
# The host name the browser uses (printed at the end of bootstrap.sh). The public URL is https://<it>.
PUBLIC_HOST=bulkpilot.tailXXXX.ts.net
# staging : bulkpilot-staging.tailXXXX.ts.net (its own Tailscale node: see TS_AUTHKEY below)
# Staging only: a pre-approved, tagged (tag:server) Tailscale auth key for its own node. Empty in production.
TS_AUTHKEY=

# —— Secrets of the application ————————————————————————————————————————————————————
APP_SECRET=
# Encrypts the 2FA seeds: changing it later disables every enrolled authenticator.
APP_ENCRYPTION_KEY=
# Database password of the `database` service (on the server, never exposed).
POSTGRES_PASSWORD=
# A managed PostgreSQL instead (ADR-0033): EXTERNAL_DATABASE=1 and its full URL.
EXTERNAL_DATABASE=0
# Memory of PostgreSQL (defaults 1GB / 4GB for production). staging : 256MB / 1GB (staging is capped at 1.5 GB)
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
# DATABASE_URL=postgresql://user:password@host:5432/db?serverVersion=18&charset=utf8&sslmode=require

# —— Accounts ——————————————————————————————————————————————————————————————————————
# true just long enough to create the owner's account, then false (docs/DEPLOYMENT.md §5).
REGISTRATION_ENABLED=false
# staging : true
# Google sign-in (optional): one OAuth client per environment, redirect URI https://<PUBLIC_HOST>/api/auth/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# —— Email (Brevo, one SMTP key per environment) ———————————————————————————————————————
# Login: the address shown in Brevo → SMTP & API → SMTP (xxxx@smtp-brevo.com), key: xsmtpsib-…
MAILER_DSN=smtp://LOGIN%40smtp-brevo.com:SMTP_KEY@smtp-relay.brevo.com:587
# The sender verified in Brevo (Senders, domains & IPs → Senders).
MAILER_FROM=BulkPilot <you@example.com>
OPEN_FOOD_FACTS_USER_AGENT=BulkPilot/1.0 (you@example.com)

# —— Progress photos (Cloudflare R2, bucket bulkpilot-photos; staging : bulkpilot-photos-staging) ——————
# EU jurisdiction: https://ACCOUNT_ID.eu.r2.cloudflarestorage.com (else https://ACCOUNT_ID.r2.cloudflarestorage.com)
S3_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
S3_BUCKET=bulkpilot-photos
# The API token of this bucket only (Object Read & Write, applied to this bucket).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# —— Backups (bucket bulkpilot-backups; staging : bulkpilot-backups-staging) ——————————————————
# Keep a copy OUTSIDE the server too (password manager): without it no backup can be read.
BACKUP_PASSPHRASE=
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=bulkpilot-backups
# Days kept: longer than the bucket lock (30 days in production). staging : 8 (lock 7)
BACKUP_RETENTION_DAYS=31
# Its own token (never the photos'): docs/DEPLOYMENT.md §1.
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# —— Monitoring (docs/MONITORING.md), all optional ———————————————————————————————————————
# Sentry or GlitchTip DSNs (API project, then the « Browser JavaScript » one for the PWA).
SENTRY_DSN=
PWA_SENTRY_DSN=
# healthchecks.io ping URLs (https://hc-ping.com/<uuid>), one check each.
HEARTBEAT_URL_SCHEDULER=
HEARTBEAT_URL_BACKUP=
HEARTBEAT_URL_BACKUP_VERIFY=
