{
  "name": "app-pwa",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "budget": "node scripts/bundle-budget.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "api:types": "openapi-typescript openapi/openapi.json -o app/types/api.d.ts",
    "pwa:icons": "pwa-assets-generator && pwa-assets-generator --config pwa-assets.maskable.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "ofetch": "^1.5.1",
    "uqr": "^0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zxing-wasm": "^3.1.4"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "lighthouse": "13.5.0",
    "nuxt": "^4.6.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
