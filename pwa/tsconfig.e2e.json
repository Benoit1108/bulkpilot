{
  // The Playwright specs and the Lighthouse check run in Node, outside Nuxt: type-checked here
  // (`pnpm typecheck:e2e`, part of `pnpm typecheck`), strict like the app.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "lighthouse/**/*.ts", "playwright.config.ts", "playwright.lighthouse.config.ts"]
}
