<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <embeddable name="App\Identity\Domain\User\Profile">
        <field name="firstName" length="50"/>
        <field name="birthDate" type="date_immutable" nullable="true"/>
        <field name="sex" length="10" nullable="true" enum-type="App\Identity\Domain\User\Sex"/>
        <field name="heightCm" type="smallint" nullable="true"/>
    </embeddable>
</doctrine-mapping>
