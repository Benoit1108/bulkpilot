<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Training\Domain\Exercise\Exercise" table="exercises">
        <indexes>
            <index name="exercises_owner_idx" columns="owner_id"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="exercises_library_key_unique" columns="library_key"/>
        </unique-constraints>

        <id name="id" type="exercise_id"/>
        <field name="version" type="integer" version="true"/>
        <field name="source" length="10" enum-type="App\Training\Domain\Exercise\ExerciseSource"/>
        <field name="libraryKey" length="60" nullable="true"/>
        <field name="ownerId" type="user_id" nullable="true"/>
        <field name="name" length="100"/>
        <field name="primaryMuscle" length="20" enum-type="App\Training\Domain\Exercise\Muscle"/>
        <field name="secondaryMuscles" type="muscles"/>
        <field name="type" length="10" enum-type="App\Training\Domain\Exercise\ExerciseType"/>
        <field name="equipment" length="20" enum-type="App\Training\Domain\Exercise\Equipment"/>
        <field name="measurement" length="10" enum-type="App\Training\Domain\Exercise\Measurement"/>
        <field name="description" type="text" nullable="true"/>
        <field name="mediaUrl" length="500" nullable="true"/>
        <embedded name="repRange" class="App\Training\Domain\Prescription\RepRange" column-prefix="rep_"/>
        <field name="targetRir" type="smallint" nullable="true"/>
        <field name="restSeconds" type="smallint"/>
        <field name="tempo" type="tempo" length="15" nullable="true"/>
        <field name="searchKey" type="text"/>
        <field name="muscleKey" length="200"/>
        <field name="createdAt" type="datetimetz_immutable"/>
        <field name="deletedAt" type="datetimetz_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
