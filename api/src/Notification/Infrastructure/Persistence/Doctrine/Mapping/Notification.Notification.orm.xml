<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Notification\Domain\Notification\Notification" table="notifications">
        <unique-constraints>
            <!-- One notification per subject, ever (spec §77). -->
            <unique-constraint name="notifications_owner_key" columns="owner_id,dedup_key"/>
        </unique-constraints>
        <indexes>
            <index name="notifications_owner_created" columns="owner_id,created_at"/>
        </indexes>

        <id name="id" type="notification_id"/>
        <field name="ownerId" type="user_id"/>
        <field name="category" length="30" enum-type="App\Notification\Domain\Notification\Category"/>
        <field name="dedupKey" length="120"/>
        <field name="title" length="200"/>
        <field name="body" type="text"/>
        <field name="link" length="200" nullable="true"/>
        <field name="createdAt" type="datetimetz_immutable"/>
        <field name="readAt" type="datetimetz_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
