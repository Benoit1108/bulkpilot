# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Commercial name is a working title: keep it out of domain code (see docs/adr/0011).
APP_DISPLAY_NAME=BulkPilot

###> symfony/routing ###
DEFAULT_URI=https://localhost
###< symfony/routing ###
###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
MAILER_FROM=no-reply@localhost

# 32 random bytes, base64 (`head -c 32 /dev/urandom | base64`). Encrypts second-factor seeds at rest.
# Required in production, never committed there; changing it invalidates every enrolled authenticator.
APP_ENCRYPTION_KEY=

# Google sign-in (OpenID Connect). Leave empty to disable. Redirect URI to register at Google:
# <DEFAULT_URI>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anyone may create an account when true. Keep false in production once the owner's account exists.
REGISTRATION_ENABLED=false

# Attempts allowed per window (see config/packages/framework.yaml → rate_limiter).
RATE_LIMIT_SIGN_IN=5
RATE_LIMIT_SIGN_IN_IP=30
RATE_LIMIT_SIGN_IN_ACCOUNT=50
RATE_LIMIT_PASSWORD_CONFIRM=10
RATE_LIMIT_REGISTRATION=5
RATE_LIMIT_EMAIL_LINKS=10
RATE_LIMIT_SECOND_FACTOR=5
RATE_LIMIT_BARCODE_SCAN=30
RATE_LIMIT_TRAINING_WRITES=600
RATE_LIMIT_PROGRESSION_WRITES=120
RATE_LIMIT_COACH_WRITES=30
RATE_LIMIT_PREFERENCE_WRITES=30
RATE_LIMIT_NOTIFICATION_WRITES=60
RATE_LIMIT_EXPORT_WRITES=5

###> audit ###
# Days the account activity (audit journal) is kept (ADR-0030).
AUDIT_RETENTION_DAYS=365
###< audit ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
# Overridden by docker compose; this value only documents the expected format.
DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Serialises rate-limiter state updates. flock is enough for one instance; use
# postgresql+advisory://… when several replicas share the limits.
LOCK_DSN=flock
###< symfony/lock ###

###> nutrition ###
# Packaged products database for barcode scans: "openfoodfacts" (online, cached) or "fake" (offline).
FOOD_DATABASE=openfoodfacts
# Open Food Facts asks clients to identify themselves: AppName/Version (contact).
OPEN_FOOD_FACTS_USER_AGENT="BulkPilot/0.1 (self-hosted personal app)"
###< nutrition ###

###> media (progress photos, ADR-0027) ###
# "local" (var/media, development and tests) or "s3" (a private S3-compatible bucket, production).
MEDIA_STORAGE=local
S3_ENDPOINT=
# The endpoint the browser reaches for presigned links, when not the server's (empty: S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false
###< media ###

###> backups (ADR-0031) ###
# Nightly encrypted database backups to a bucket of their own, a test restore every week.
# Required in production (the image refuses to start without them); off in development.
BACKUP_ENABLED=0
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PATH_STYLE=false
###< backups ###

###> monitoring (docs/MONITORING.md) ###
# Errors of the API (Sentry or GlitchTip DSN); empty: none reported. Only read in production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
# Errors of the PWA (a browser DSN is public), served by GET /api/client-config; empty: none reported.
PWA_SENTRY_DSN=
# The version deployed: the image's git commit (a build argument), `dev` otherwise.
APP_RELEASE=dev
# Whether the health report expects backups (`/api/health?scope=monitoring`): `1` on the API container
# of an environment whose worker backs up; off in development.
BACKUPS_MONITORED=0
# healthchecks.io ping URLs (https://hc-ping.com/<uuid>), outside the server; empty: not watched from outside.
HEARTBEAT_URL_SCHEDULER=
HEARTBEAT_URL_BACKUP=
HEARTBEAT_URL_BACKUP_VERIFY=
###< monitoring ###

###> proxy ###
# Addresses whose X-Forwarded-* headers are trusted (framework.yaml): empty in development,
# PRIVATE_SUBNETS on the server behind `tailscale serve` (docs/DEPLOYMENT.md).
TRUSTED_PROXIES=
###< proxy ###
