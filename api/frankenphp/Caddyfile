{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

# Production: the Nuxt SPA is built into the image and served as static files.
(pwa_static) {
	root * /app/pwa

	# What the page may load (ADR-0027, spec §101): its own scripts and those inline ones built with
	# it (by hash), photos from the bucket, nothing framed, no plugin, forms to itself only.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' {$CSP_SCRIPT_HASHES}; style-src 'self'; img-src 'self' data: blob: {$CSP_MEDIA_SOURCES}; connect-src 'self' {$CSP_MEDIA_SOURCES}; font-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"

	# Hashed build assets: cached forever when they exist, a plain 404 otherwise
	# (never index.html, which would be cached as a broken script after a deploy).
	@nuxt path /_nuxt/*
	handle @nuxt {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		@revalidate path / /index.html /sw.js /manifest.webmanifest /theme-init.js
		header @revalidate Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Development: requests are proxied to the Nuxt dev server (HMR over the same origin).
(pwa_dev) {
	reverse_proxy {$PWA_UPSTREAM:pwa:3000}
}

# Container healthcheck only: reachable from inside the container, never published.
http://127.0.0.1:2080 {
	bind 127.0.0.1
	root /app/public
	@health path /api/health
	handle @health {
		php_server
	}
	respond 404
}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Never log credentials or session identifiers
		format filter {
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
			# One-time link secrets and OAuth codes travel in query strings.
			request>uri query {
				replace token REDACTED
				replace code REDACTED
				replace state REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	# One identifier per request, shared by the response and the API error payloads
	# (the client-supplied value is never trusted).
	request_header X-Request-Id {http.request.uuid}

	header {
		X-Request-Id {http.request.uuid}
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Symfony handles the API and its tooling; everything else is the Nuxt PWA.
	# Serving both from one origin keeps session cookies first-party (SameSite=Lax, httpOnly).
	@backend path /api /api/* /bundles/* /_profiler /_profiler/* /_wdt/* /_error/*

	handle @backend {
		php_server
	}

	handle {
		import {$PWA_MODE:pwa_static}
	}
}
